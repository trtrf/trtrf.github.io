    <item>
      <title>ascii</title>
      <link>https://trtrf.github.io/group/ascii/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://trtrf.github.io/group/ascii/</guid>
      <description>&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;yellow&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;~&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;_&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;+&lt;/th&gt;&#xA;          &lt;th&gt;{&lt;/th&gt;&#xA;          &lt;th&gt;}&lt;/th&gt;&#xA;          &lt;th&gt;?&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;|&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;:&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&amp;quot;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&amp;lt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&amp;gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;!&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;@&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;#&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;$&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;%&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;^&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&amp;amp;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;*&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;(&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;)&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;explanation&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Equivalency sign - tilde&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;lowbar&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Plus&lt;/td&gt;&#xA;          &lt;td&gt;Opening brace&lt;/td&gt;&#xA;          &lt;td&gt;Closing brace&lt;/td&gt;&#xA;          &lt;td&gt;Question mark&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Vertical bar&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Colon&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Double quotes&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Less than (or open angled bracket)&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Greater than (or close angled bracket)&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Exclamation mark&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;At sign&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Number sign&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Dollar&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Percent sign&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Caret - circumflex&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Ampersand&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Asterisk&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Open parenthesis (or open bracket)&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Close parenthesis (or close bracket)&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;green&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;`&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;-&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;=&lt;/td&gt;&#xA;          &lt;td&gt;[&lt;/td&gt;&#xA;          &lt;td&gt;]&lt;/td&gt;&#xA;          &lt;td&gt;/&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;\&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;;&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&#39;&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;,&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;.&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;1&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;2&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;3&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;4&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;5&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;6&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;7&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;8&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;9&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;0&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;explanation&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;grave&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Hyphen-minus&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;equals&lt;/td&gt;&#xA;          &lt;td&gt;Opening bracket&lt;/td&gt;&#xA;          &lt;td&gt;Closing bracket&lt;/td&gt;&#xA;          &lt;td&gt;Slash or divide&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Backslash&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Semicolon&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Single quote&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Comma&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Period, dot or full stop&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;one&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;two&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;three&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;four&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;five&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;six&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;seven&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;eight&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;nine&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;zero&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;letter&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;how to write&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Ee&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Ss&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Zz&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Xx&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Yy&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;letter&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;how to write&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Aa&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;cursive a.i come down and i have to go up for the next a.the a started at the top.&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Oo&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;The letter o is a circle with a little loop on th top.&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Nn&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Tt&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Dd&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Cc&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Qq&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;letter&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;how to write&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Ii&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;go straight up and back down the line.then it split here because it needs to go to the next letter.we lift our pen and make the dot.&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Uu&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;It starts at bottom,goes up and stright down,make a curve,goes up again,and come straight down.&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Mm&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Pp&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Bb&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Hh&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Ff&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Vv&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Rr&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;letter&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;how to write&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Ll&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;go up and down,up.it&amp;rsquo;s just a series of loops and each one is connected.&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Ww&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;the w finishes at the top just like the o and the v,so all of the connections to other letters are going to be made from the top position not from down here.&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Jj&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Kk&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Gg&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;</description>
